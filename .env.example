# Get a key at https://aistudio.google.com/apikey  (you can also paste it in the HUD on first launch)
GEMINI_API_KEY=
# Live model (default: Google's recommended Live model)
GEMINI_MODEL=gemini-3.8-live
# Prebuilt voice: Charon, Puck, Kore, Fenrir, Aoede, Orus, Zephyr ...
GEMINI_VOICE=Charon
# How the assistant addresses you
USER_TITLE=sir
# Skip the approve/deny dialog for dangerous tools (shell, file writes). Not recommended.
AUTO_APPROVE=false
# Gemini model used to locate on-screen targets precisely (locate_on_screen)
GEMINI_VISION_MODEL=gemini-3.8-flash
